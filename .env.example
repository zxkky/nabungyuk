# Server
SERVER_PORT=8081

# Database
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password
DB_NAME=nabungyuk

# JWT - set to a strong secret (minimum 32 characters)
JWT_SECRET=your_strong_jwt_secret_at_least_32_chars

# CORS - comma-separated list of allowed frontend origins
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Reminder scheduler (e.g. 30s for dev, 1m for prod, "disabled" to turn off)
REMINDER_CHECK_INTERVAL=30s

# SMTP (Email)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_app_password
# Reverse proxy CIDRs/IPs allowed to provide X-Forwarded-For (optional, comma-separated)
TRUSTED_PROXIES=
